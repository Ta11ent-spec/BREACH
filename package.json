{
  "name": "breach-intel-website",
  "version": "1.1.3",
  "private": true,
  "description": "BREACH / INTEL — Rainbow Six Siege analytics UI and future official website",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:network": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:analytics": "node --test tests/overviewAccuracy.test.cjs",
    "test:matches": "node --test tests/matchAccuracy.test.cjs",
    "test:players": "node --test tests/playerAccuracy.test.cjs",
    "test:maps": "node --test tests/mapAccuracy.test.cjs",
    "test:operators": "node --test tests/operatorAccuracy.test.cjs",
    "test:reports": "node --test tests/reportAccuracy.test.cjs",
    "test:collector": "node --test tests/collectorContract.test.cjs",
    "test": "node --test tests/*.test.cjs"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.28.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
