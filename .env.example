# No credentials needed for the UI-only demo.
# Frontend Vite env vars with VITE_ prefix are PUBLIC in the browser.
# Never put Ubisoft tokens, API secrets, or database credentials here.
# VITE_PUBLIC_APP_NAME=BREACH / INTEL
# Public Auth0 SPA identifiers only. Never add a client secret here.
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=https://breach-intel-api
